# Copy to `.env` in the repo root. Loaded on every `import src.lib` (a variable already
# set in the shell wins). Never commit `.env`.

# OpenRouter key for the LLM judge (judge_rollouts, batch_judge_rollouts, judge_validation).
OPENROUTER_API_KEY=

# Hugging Face token: gated datasets (GPQA) and the `hf` activation-store backend.
HF_TOKEN=

# Root of the data tree every `${DATA_ROOT}/...` config path resolves against.
# Unset = <repo>/data.
DATA_ROOT=

# Optional: where Hugging Face caches model weights and datasets.
# HF_HOME=
